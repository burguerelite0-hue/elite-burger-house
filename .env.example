# Copy this file to .env.local for development or configure the same variables
# in the production environment. Never commit .env, .env.local or real values.

# MySQL connection string. URL-encode special characters in USER/PASSWORD.
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/elite_burger_house"

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="replace-with-a-long-random-secret"

# Store only a bcrypt hash in ADMIN_PASSWORD_HASH; never put a plain password here.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD_HASH="replace-with-a-bcrypt-hash"